<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- PSG Academic PDF's own MSI: an independent product with its own UpgradeCode, install folder,
       Start menu entry, file associations and uninstall entry. Its identity is in
       packaging/products.toml (`cargo xtask products check` compares them). It shares the
       dual-scope policy (install-policy.wxi) and the dialogs (installer-ui.wxs) with PSG PDF. -->
  <?define ProductFolder="PSG Academic PDF" ?>
  <?define ProductRegKey="Software\PSG Academic PDF" ?>
  <?define ProductExe="psg-academic-pdf.exe" ?>
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="PSG Academic PDF" Manufacturer="Panorama Scholarly Group" Version="$(var.Version)" UpgradeCode="B43E2C11-55A0-457B-9A21-7582C52506D9" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="PSG Academic PDF: typesetting accepted articles with pdfLaTeX" Manufacturer="Panorama Scholarly Group" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive betas of one X.Y.Z replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of PSG Academic PDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Migrating from the PSG PDF Suite (0.18.x): it installed this app beside PSG PDF under the
         suite's UpgradeCode, which PSG PDF now continues. Removing the suite from here would take
         PSG PDF away too, so this package only detects it and asks for PSG PDF's installer first:
         that replaces the suite in place (keeping folder, scope and settings), and this package
         then installs beside it. Detected two ways, so a suite installed for the other scope (which
         FindRelatedProducts doesn't see) counts as well: the suite's UpgradeCode below
         split_version, and the Start menu record only the suite wrote. -->
    <Upgrade Id="C984AB08-3E67-48B7-8DC2-6F1428165299">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" Maximum="0.19.0" IncludeMaximum="no" OnlyDetect="yes" Property="PSGSUITEFOUND" />
    </Upgrade>
    <Property Id="PSGSUITEACADEMICU" Secure="yes">
      <RegistrySearch Id="PsgSuiteAcademicUser" Root="HKCU" Key="Software\PSG PDF\Shortcuts" Name="AcademicStartMenu" Type="raw" />
    </Property>
    <Property Id="PSGSUITEACADEMICM" Secure="yes">
      <?if $(sys.BUILDARCH) = x86 ?>
      <RegistrySearch Id="PsgSuiteAcademicMachine" Root="HKLM" Key="Software\PSG PDF\Shortcuts" Name="AcademicStartMenu" Type="raw" />
      <?else?>
      <RegistrySearch Id="PsgSuiteAcademicMachine" Root="HKLM" Key="Software\PSG PDF\Shortcuts" Name="AcademicStartMenu" Type="raw" Bitness="always64" />
      <?endif?>
    </Property>
    <Launch Condition="Installed OR (NOT PSGSUITEFOUND AND NOT PSGSUITEACADEMICU AND NOT PSGSUITEACADEMICM)" Message="The PSG PDF Suite (0.18) is installed, and it already contains PSG Academic PDF. Install the new PSG PDF first: it replaces the suite and keeps your settings. Then run this installer again." />

    <Icon Id="PsgAcademicIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PsgAcademicIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/WENSHAO521/psg-pdf" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/WENSHAO521/psg-pdf/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/WENSHAO521/psg-pdf/issues" />
    <!-- Desktop shortcut: on for a first install, kept on update only while it is still on the
         desktop, INSTALLDESKTOPSHORTCUT=0 for unattended installs (as PSG PDF's). -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="EXISTINGDESKTOPSHORTCUT_USER">
      <DirectorySearch Id="DesktopSearchUser" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="PSG Academic PDF.lnk" />
      </DirectorySearch>
    </Property>
    <Property Id="EXISTINGDESKTOPSHORTCUT_MACHINE">
      <DirectorySearch Id="DesktopSearchMachine" Path="[%PUBLIC]\Desktop" Depth="0">
        <FileSearch Name="PSG Academic PDF.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="EXISTINGDESKTOPSHORTCUT" Action="CraftExistingMachineShortcut" Value="[EXISTINGDESKTOPSHORTCUT_MACHINE]" After="CraftMFromLegacyExe" Sequence="first" Condition="ALLUSERS = 1 AND EXISTINGDESKTOPSHORTCUT_MACHINE" />
    <SetProperty Id="EXISTINGDESKTOPSHORTCUT" Action="CraftExistingUserShortcut" Value="[EXISTINGDESKTOPSHORTCUT_USER]" After="CraftExistingMachineShortcut" Sequence="first" Condition="ALLUSERS &lt;&gt; 1 AND EXISTINGDESKTOPSHORTCUT_USER" />
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="CraftExistingUserShortcut" Sequence="first" Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />
    <UIRef Id="PdfcraftInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Panorama Scholarly Group">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductFolder)">
          <!-- Journal templates, where the app looks for them: templates\academic beside the exe
               (crates/academic/src/template.rs). The PSG Research Article is also compiled in. -->
          <Directory Id="TemplatesRoot" Name="templates">
            <Directory Id="TemplatesFolder" Name="academic" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="PSG Academic PDF" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="AcademicFiles" />
      <ComponentGroupRef Id="AcademicTemplates" />
    </Feature>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="AcademicFiles" Directory="INSTALLFOLDER">
      <Component Id="AcademicApp" Guid="9A5AAB7F-0B13-4C51-B9E6-81BBD0933895">
        <File Id="AcademicExe" Source="$(var.BinDir)\psg-academic-pdf.exe" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\psg-academic-pdf.exe" Value="[#AcademicExe]" Type="string" />
        <!-- Manuscripts (.tex, .docx): PSG Academic PDF is offered under "Open with" and in Default
             apps, and starts a new project around the file. It never becomes the default for
             either type; the user chooses. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\PSGAcademicPDF.Manuscript" Value="Manuscript for PSG Academic PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\PSGAcademicPDF.Manuscript\DefaultIcon" Value="&quot;[#AcademicExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\PSGAcademicPDF.Manuscript\shell\open\command" Value="&quot;[#AcademicExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tex\OpenWithProgids" Name="PSGAcademicPDF.Manuscript" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docx\OpenWithProgids" Name="PSGAcademicPDF.Manuscript" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\psg-academic-pdf.exe" Name="FriendlyAppName" Value="PSG Academic PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\psg-academic-pdf.exe\SupportedTypes" Name=".tex" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\psg-academic-pdf.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\psg-academic-pdf.exe\shell\open\command" Value="&quot;[#AcademicExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\PSG Academic PDF\Capabilities" Name="ApplicationName" Value="PSG Academic PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\PSG Academic PDF\Capabilities" Name="ApplicationDescription" Value="Typesetting accepted articles with pdfLaTeX" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\PSG Academic PDF\Capabilities" Name="ApplicationIcon" Value="[#AcademicExe],0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\PSG Academic PDF\Capabilities\FileAssociations" Name=".tex" Value="PSGAcademicPDF.Manuscript" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\PSG Academic PDF\Capabilities\FileAssociations" Name=".docx" Value="PSGAcademicPDF.Manuscript" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="PSG Academic PDF" Value="Software\PSG Academic PDF\Capabilities" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\PSG Academic PDF" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- Plain (non-advertised) shortcuts, each with its own registry key path, as PSG PDF's. -->
      <Component Id="AcademicStartMenuShortcut" Directory="ProgramMenuFolder" Guid="72697ACF-01B1-42D0-9A61-124977CE4DDE">
        <Shortcut Id="StartMenuShortcut" Name="PSG Academic PDF" Description="Typesetting accepted articles with pdfLaTeX" Target="[#AcademicExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\PSG Academic PDF\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="AcademicDesktopShortcut" Directory="DesktopFolder" Guid="93B10C4E-712C-4C77-96F0-2D5F800BC7E9" Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="PSG Academic PDF" Description="Typesetting accepted articles with pdfLaTeX" Target="[#AcademicExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\PSG Academic PDF\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="AcademicMitLicense">
        <File Id="AcademicMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="AcademicApacheLicense">
        <File Id="AcademicApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="AcademicNotice">
        <File Id="AcademicNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Every file under templates\academic (package.ps1 stages the repository's folder), one
         component each, so new templates ship without naming them here. -->
    <ComponentGroup Id="AcademicTemplates" Directory="TemplatesFolder">
      <Files Include="$(var.TemplatesDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
