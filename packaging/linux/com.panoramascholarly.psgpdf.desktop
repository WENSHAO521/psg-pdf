[Desktop Entry]
Type=Application
Name=PSG PDF
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=psg-pdf %U
TryExec=psg-pdf
Icon=com.panoramascholarly.psgpdf
Terminal=false
