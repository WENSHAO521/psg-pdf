<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PSG Academic PDF. Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>PSG Academic PDF</string>
  <key>CFBundleName</key>
  <string>PSG Academic PDF</string>
  <key>CFBundleExecutable</key>
  <string>PSG Academic PDF</string>
  <key>CFBundleIdentifier</key>
  <string>com.panoramascholarly.psgacademicpdf</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>PSGAcademicPDFVersion</key>
  <string>@VERSION@</string>
  <key>PSGAcademicPDFBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>PSG Academic PDF</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>© Panorama Scholarly Group. Based on PdfCraft, © the PdfCraft authors. MIT OR Apache-2.0.</string>

  <!-- Manuscripts PSG Academic PDF opens: a LaTeX body or a Word manuscript starts a new project
       around the file. Offered under Open With only ("Alternate"); it never takes over .tex or
       .docx. Finder hands the file over as an Apple event (apps/psg-academic-pdf/src/main.rs). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>LaTeX manuscript</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>org.tug.tex</string><string>public.tex</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>tex</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Word manuscript</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>org.openxmlformats.wordprocessingml.document</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>docx</string></array>
    </dict>
  </array>
</dict>
</plist>
